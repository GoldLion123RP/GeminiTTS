---
// Phase 5.3 — the generated-audio result.
//
// The plan lists this as its own file, and it is kept as one: this is the only
// place the result markup exists. TtsPanel clones the <template> below and
// fills the three data slots, so the structure is authored in Astro (styled
// and type-checked like everything else) while the values come from the
// response at runtime. Two copies of this markup would drift.
//
// DESIGN.md shapes:
//   `components.feature-card` for the surface — white, 1px hairline, rounded.md
//     (12px) → rounded-card, body-md type, padding {spacing.lg} 24px. A hairline
//     card inside the panel's own card gives the depth step the system wants
//     (Level 0 flat → Level 1 whisper) without a second shadow.
//   `components.button-primary` for Download — ink fill, white label,
//     rounded.pill (100px), padding 0 14px, {typography.button-lg} 16/20.
//   `components.mono-eyebrow` for the "Result" label — Geist Mono, 12/16,
//     uppercase, {colors.mute}.
//   Metadata line is {typography.body-sm} 12/16 in {colors.mute}.
---

<div id="tts-result" class="mt-6"></div>

<template id="tts-audio-result">
	<div class="flex flex-col gap-3 rounded-card border border-hairline bg-helevated p-6 shadow-whisper">
		<p class="font-mono text-xs leading-4 font-medium tracking-normal text-mute uppercase">
			Result
		</p>
		<!-- controls + src are set by the script; preload="metadata" fetches
		     just enough to show duration without pulling the whole WAV. -->
		<audio data-role="audio" controls preload="metadata" class="w-full"></audio>
		<p data-role="facts" class="text-xs leading-4 text-mute"></p>
		<a
			data-role="download"
			download="speech.wav"
			class="w-fit cursor-pointer rounded-pill bg-ink px-3.5 py-1 text-base leading-5 font-medium text-on-primary no-underline"
		>
			Download WAV
		</a>
	</div>
</template>
