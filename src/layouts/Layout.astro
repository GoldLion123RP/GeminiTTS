---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		{/*
			Astro emits an @font-face only for a cssVariable a stylesheet
			actually references. global.css binds --font-sans / --font-mono to
			these two; without <Font> they download and are never applied.
		*/}
		<Font cssVariable="--font-geist" preload={[{ weight: 400 }, { weight: 500 }, { weight: 600 }]} />
		<Font cssVariable="--font-geist-mono" />
	</head>
	<body>
		<slot />
	</body>
</html>
