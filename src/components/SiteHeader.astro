---
/**
 * Site header — DESIGN.md `components.nav-bar`.
 *
 *   Background {colors.canvas}, bottom hairline {colors.hairline},
 *   text {colors.body}, type {typography.body-md},
 *   padding {spacing.sm} {spacing.lg}  →  8px 24px
 *
 * The nav row holds the wordmark at left and `nav-link` ghost items at right,
 * per the `nav-bar` description ("Holds the black wordmark, ghost nav links").
 *
 * `nav-link` is `rounded-full`, NOT the 6px `rounded-sm` app-button radius. The
 * two are different components: DESIGN.md reserves `button-primary-sm` /
 * `button-ghost-sm` for the Sign Up / Log In *buttons*, and the nav row in
 * this app has none. Reaching for `rounded-app` here would have mixed the two
 * button shapes inside one context, which DESIGN.md lists under Don'ts.
 *
 * The route list lives in `src/lib/nav.ts` so this file never hardcodes a
 * path. Items whose page does not exist yet are omitted rather than linked
 * (see the note there) — Phase 3 flips their flags.
 */
import { isActive, visibleNavItems } from '../lib/nav';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const items = visibleNavItems();
---

{/* Skip link. First focusable element on every page so keyboard users bypass
    the nav row on every route.

    No `sr-only`: that utility and `focus:not-sr-only` fought over
    `position`/size and the focused link stayed collapsed to 1x1px. Both
    states now live in one self-contained `.skip-link` pair in global.css —
    visible by default, hidden by `:not(:focus)`. One owner for the
    behaviour, and nothing to out-specify. */}
<a
	href="#main"
	class="skip-link rounded-app bg-elevated text-sm leading-5 font-medium text-ink ring-1 ring-hairline"
>
	Skip to content
</a>

{/* Sticky per plan 1.2. Background is the literal `nav-bar` background,
    `{colors.canvas}` — not a translucent variant. A see-through header would
    be a token combination DESIGN.md does not sanction, and the blur is a
    flourish in a system whose one flourish is the hero mesh. */}
<header class="sticky top-0 z-40 border-b border-hairline bg-canvas">
	<div class="container-page flex h-14 items-center justify-between gap-4">
		{/* Wordmark. Black, per `nav-bar`: "Holds the black wordmark". It is a
		    link home, so the chrome's own primary target is reachable from
		    every route. `tracking-normal` is the Indic-safe base; `latin`
		    restores the design-system tracking, per the same ruling as Hero.

		    PHASE 3 FIX: `aria-current` was removed here. With only one route
		    this was invisible, but now that the "Home" nav item exists, `/`
		    matched BOTH the wordmark and the Home link and put
		    `aria-current="page"` on two controls at once. It is a single-value
		    attribute: it does not read as "these two both point at the current
		    page", it announces the current page twice and leaves a screen
		    reader user with no way to tell which mark is the real one. The
		    wordmark is a brand link that happens to point home; the nav item is
		    the thing that represents a location, so it owns the attribute. */}
		<a
			href="/"
			class="text-base leading-5 font-semibold tracking-normal text-ink latin:tracking-[-0.04em]"
		>
			GeminiTTS
		</a>

		{/* Desktop nav. `hidden`/`sm:flex` matches the DESIGN.md breakpoint
		    table: "nav → menu trigger" at ≤640px, "full nav row" at laptop.
		    640px is Tailwind's `sm`, so the trigger shows below that. */}
		<nav aria-label="Main" class="hidden items-center gap-1 sm:flex">
			{
				items.map((item) => (
					<a
						href={item.href}
						aria-current={isActive(pathname, item.href) ? 'page' : undefined}
						class:list={[
							'px-2 py-1 text-sm leading-5 rounded-full',
							isActive(pathname, item.href)
								? 'text-ink font-medium'
								: 'text-body hover:text-ink',
						]}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		{/* Phase 2.3: theme control. Sits after the nav, before the mobile
		    trigger, so on desktop the order is wordmark → nav → theme, and on
		    a narrow screen the trigger stays the right-most control. Hidden
		    below `sm` only to keep the 56px row from crowding at 320px — the
		    theme is still reachable on a phone by widening, and the mobile
		    menu is the primary navigation there. */}
		<div class="hidden sm:block">
			<ThemeToggle />
		</div>

		{/* Mobile trigger. Only rendered when there is more than one route —
		    a hamburger that opens a single link is a control that lies about
		    what it controls.

		    PHASE 5.4: `size-10` (40px), up from `h-9 w-9` (36px). Phase 3
		    already settled on 40px as the floor for a control this small, and
		    the trigger was missed. It is the only header control a phone user
		    has to hit to reach navigation, so it is the one least affordance
		    to spare. It still fits the 56px row with 8px to spare. */}
		{
			items.length > 1 && (
				<button
					type="button"
					id="nav-menu-trigger"
					aria-expanded="false"
					aria-controls="nav-menu"
					class="inline-flex size-10 items-center justify-center rounded-app border border-hairline bg-elevated text-ink sm:hidden"
				>
					<span class="sr-only">Open navigation menu</span>
					<svg
						viewBox="0 0 24 24"
						width="18"
						height="18"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						aria-hidden="true"
					>
						<path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
					</svg>
				</button>
			)
		}
	</div>

	{/* Collapsed nav. Rendered in the DOM at all widths and revealed by the
	    trigger, rather than conditionally inserted: `aria-controls` must point
	    at an element that exists, or the relationship is a lie. Hidden via
	    the `hidden` attribute so it leaves the tab order when collapsed. */}
	<nav
		id="nav-menu"
		aria-label="Mobile"
		hidden
		class="border-t border-hairline sm:hidden"
	>
		<div class="container-page flex flex-col gap-1 py-3">
			{
				items.map((item) => (
					<a
						href={item.href}
						aria-current={isActive(pathname, item.href) ? 'page' : undefined}
						class:list={[
							'px-2 py-2 text-sm leading-5 rounded-full',
							isActive(pathname, item.href)
								? 'text-ink font-medium'
								: 'text-body hover:text-ink',
						]}
					>
						{item.label}
					</a>
				))
			}
		</div>
	</nav>
</header>

<script>
	// Mobile nav toggle.
	//
	// `aria-expanded` is the whole state contract, so it is written in one
	// place and read from that same place — never tracked twice in parallel.
	// The label is swapped from the trigger's own `aria-expanded` rather than
	// from a second variable, which is the usual source of the two drifting
	// apart.
	const trigger = document.getElementById('nav-menu-trigger');
	const menu = document.getElementById('nav-menu');

	if (trigger instanceof HTMLButtonElement && menu instanceof HTMLElement) {
		const setOpen = (open: boolean) => {
			trigger.setAttribute('aria-expanded', String(open));
			menu.hidden = !open;
			const label = trigger.querySelector('.sr-only');
			if (label) {
				label.textContent = open ? 'Close navigation menu' : 'Open navigation menu';
			}
		};

		trigger.addEventListener('click', () => {
			const open = trigger.getAttribute('aria-expanded') !== 'true';
			setOpen(open);
			// PHASE 6 FIX: opening the menu moves focus into it.
			//
			// The Escape handler below used to be bound to `menu` alone, and
			// it was dead code: activating the trigger leaves focus ON the
			// trigger, so a keydown never reached the menu and Escape did
			// nothing. Found by the Phase 6 keyboard run, not by inspection —
			// the listener was correct-looking and simply unreachable.
			//
			// Moving focus in is the fix that makes the rest coherent: it is
			// what a disclosure pattern is supposed to do (WAI-ARIA: focus
			// moves to the first item in the expanded region), it is what
			// makes the now-reachable `keydown` fire, and it means a keyboard
			// user who opens the menu is actually standing inside it rather
			// than on a button whose label has flipped to "Close".
			if (open) {
				const first = menu.querySelector<HTMLAnchorElement>('a[href]');
				first?.focus();
			}
		});

		// Escape closes and returns focus to the trigger, so a keyboard user
		// who opened the menu is never stranded behind it. Bound on the menu
		// because focus is inside it while it is open (see the fix above).
		menu.addEventListener('keydown', (event: KeyboardEvent) => {
			if (event.key === 'Escape') {
				setOpen(false);
				trigger.focus();
			}
		});

		// Following a nav link navigates; the attribute would otherwise
		// survive a same-page back-navigation with the panel stuck open.
		menu.addEventListener('click', (event: MouseEvent) => {
			const target = event.target;
			if (target instanceof Element && target.closest('a[href]')) setOpen(false);
		});

		// A resize past the `sm` breakpoint hands layout to the desktop row.
		// Leaving the panel open would then duplicate the nav, so close it.
		const desktop = window.matchMedia('(min-width: 640px)');
		desktop.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});
	}
</script>
