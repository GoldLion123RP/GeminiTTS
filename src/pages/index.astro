---
import Hero from '../components/Hero.astro';
import Layout from '../layouts/Layout.astro';
import SttPanel from '../components/SttPanel.astro';
import TtsPanel from '../components/TtsPanel.astro';

// Phases 5 and 6 are both mounted below. Nothing is stubbed: an empty mount
// point that renders a placeholder would be a state the design system never
// sanctioned.
---

<Layout
	title="GeminiTTS — speech to text, text to speech"
	description="Record speech and get clean structured writing, or turn a document into natural speech. The Gemini API key never leaves your server."
>
	<Hero
		eyebrow="Gemini · speech ⇄ text"
		title="Say it. Write it. Say it back."
		lede="Record speech and get clean, structured writing — or paste a document and hear it read back. English, বাংলা, हिन्दी, or let it auto-detect. Your API key never leaves this server."
	/>

	{/* `id="main"` is the skip link's target, mounted by SiteHeader. It was
	    `id="panels"` until Phase 1.3; nothing referenced it, and a skip link
	    pointing at a target that does not exist is silently inert. */}
	<main id="main" class="container-page pb-24">
		{/* SPEC §3.8: a 2-up card grid collapsing to one column below the
		    documented breakpoint. Speech → Text is ordered first because that
		    is the order the hero's lede describes. `items-start` stops the
		    taller column stretching its neighbour's card. */}
		<div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-2">
			<SttPanel />
			<TtsPanel />
		</div>
	</main>
</Layout>

